<?xml version="1.0" ?>
<!--
  Small indoor room (6 m x 6 m) used to demo mapping, navigation and object detection.
  Room interior: x in [-1, 5], y in [-1, 5].  The robot spawns at the world origin (0, 0).

  Detectable objects (matched by colour in amr_perception):
    red sphere   -> "ball"
    blue cubes   -> "box"
    green cyl.   -> "barrel"
  Grey boxes are plain obstacles.
-->
<sdf version="1.9">
  <world name="room">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.80 0.85 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>2 2 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Floor -->
    <model name="ground">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <material>
            <ambient>0.60 0.60 0.62 1</ambient>
            <diffuse>0.60 0.60 0.62 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls -->
    <model name="room_walls">
      <static>true</static>

      <link name="wall_north">
        <pose>2 5.05 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>2 -1.05 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>5.05 2 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-1.05 2 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Detectable objects -->
    <model name="red_ball">
      <static>true</static>
      <pose>3.0 1.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box_1">
      <static>true</static>
      <pose>0.6 3.4 0.15 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.05 0.15 0.85 1</ambient><diffuse>0.05 0.15 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box_2">
      <static>true</static>
      <pose>4.2 4.2 0.15 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.05 0.15 0.85 1</ambient><diffuse>0.05 0.15 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_barrel">
      <static>true</static>
      <pose>4.0 2.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.05 0.70 0.10 1</ambient><diffuse>0.05 0.70 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Plain obstacles -->
    <model name="grey_box_a">
      <static>true</static>
      <pose>2.0 2.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.4 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="grey_box_b">
      <static>true</static>
      <pose>3.4 3.3 0.25 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
